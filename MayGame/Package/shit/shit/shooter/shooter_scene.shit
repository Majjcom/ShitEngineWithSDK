    van eng = me.Engine
    eng.setShouldCheckUselessNodes(false)

    -- 重新加载场景
    van Scene = require("shooter_scene.shit@data.mp")
    van scn = Scene.create(self.cfg)
    eng.runWithScene(scn)
bug

return ShooterScene
